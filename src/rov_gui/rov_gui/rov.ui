  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget { background-color: #10151c; }
QLabel { color: #d7dee8; font-size: 10pt; }
QFrame#headerFrame { background-color: #151c26; border: 1px solid #2a3647; border-radius: 6px; }
QGroupBox { color: #8fb4ff; font-weight: bold; background-color: #151c26;
            border: 1px solid #2a3647; border-radius: 6px; margin-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QProgressBar { border: 1px solid #2a3647; border-radius: 3px; background-color: #0b0f14;
               color: #d7dee8; text-align: center; }
QProgressBar::chunk { background-color: #2f81f7; border-radius: 2px; }
QLabel#lbl_oakd, QLabel#lbl_cam1, QLabel#lbl_cam2, QLabel#lbl_cam3, QLabel#lbl_cam4 {
    background-color: #05080c; color: #4b5a6e; border: 1px solid #2a3647; font-size: 12pt; }
QListWidget { background-color: #0b0f14; color: #d7dee8; border: 1px solid #2a3647;
              border-radius: 4px; font-size: 10pt; }
QListWidget::item { padding: 4px; }
QPlainTextEdit { background-color: #0b0f14; color: #9fb3c8; border: 1px solid #2a3647;
                 border-radius: 4px; font-family: 'Consolas','DejaVu Sans Mono',monospace; font-size: 9pt; }
QDoubleSpinBox { background-color: #0b0f14; color: #7CFC9A; border: 1px solid #2a3647;
                 border-radius: 3px; padding: 2px 4px; font-size: 10pt; }
QPushButton { background-color: #263040; color: #d7dee8; border: 1px solid #2a3647;
              border-radius: 4px; padding: 4px 10px; }
QPushButton:hover { background-color: #2f3d52; }
QPushButton:pressed { background-color: #2f81f7; }
QTimeEdit { background-color: #0b0f14; color: #7CFC9A; border: 1px solid #2a3647;
            border-radius: 3px; padding: 2px 4px; font-size: 10pt; }
</string>
