   <string notr="true">
QMainWindow, QWidget#centralwidget { background-color: #10151c; }
QLabel { color: #d7dee8; font-size: 10pt; }
QFrame#headerFrame { background-color: #151c26; border: 1px solid #2a3647; border-radius: 6px; }
QGroupBox { color: #8fb4ff; font-weight: bold; background-color: #151c26;
            border: 1px solid #2a3647; border-radius: 6px; margin-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QProgressBar { border: 1px solid #2a3647; border-radius: 3px; background-color: #0b0f14;
               color: #d7dee8; text-align: center; }
QProgressBar::chunk { background-color: #2f81f7; border-radius: 2px; }
QLabel#lbl_oakd, QLabel#lbl_cam1, QLabel#lbl_cam2, QLabel#lbl_cam3, QLabel#lbl_cam4 {
    background-color: #05080c; color: #4b5a6e; border: 1px solid #2a3647; font-size: 12pt; }
